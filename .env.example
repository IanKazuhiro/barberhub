# Modelo de variáveis de ambiente do BarberHub.
# Copie este arquivo para ".env" e troque os valores de exemplo pelos seus.
# NUNCA coloque valores reais neste arquivo: ele é versionado.

BANCO_URL=jdbc:postgresql://localhost:5432/barberhub
BANCO_USUARIO=usuario_exemplo
BANCO_SENHA=troque_esta_senha

# Chave para assinar os tokens de login: use uma sequência longa e aleatória.
JWT_SEGREDO=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRACAO_MINUTOS=60