# Modelo de variáveis de ambiente do back-end do BarberHub.
# O back-end lê as variáveis do SISTEMA, e não deste arquivo: use-o como lista dos nomes e dos formatos.
# NUNCA coloque valores reais neste arquivo: ele é versionado.

# Banco: no Supabase, use a conexão "Session pooler" do painel, no formato JDBC.
BANCO_URL=jdbc:postgresql://host_exemplo:5432/postgres?sslmode=require
BANCO_USUARIO=postgres.codigo_do_projeto
BANCO_SENHA=troque_esta_senha

# Endereços do front-end autorizados a chamar a API (opcional), separados por vírgula.
CORS_ORIGENS=http://localhost:5173

# Login por token (UC02): ainda não são usadas.
# Chave para assinar os tokens: use uma sequência longa e aleatória.
JWT_SEGREDO=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRACAO_MINUTOS=60